# Ledgerlock environment configuration.
# Copy to `.env` and replace every placeholder. `.env` is gitignored.
# No real secret is ever committed to this repository.

# ---------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------
# Local host-side development. docker-compose maps the single-node
# replica set to localhost:27017. directConnection=true tells the driver
# to talk to this node directly instead of following the replica set's
# advertised member address, which keeps the same URI shape working both
# from the host and from inside the compose network.
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB_NAME=ledgerlock

# Inside the docker-compose network the API service uses:
#   MONGODB_URI=mongodb://mongo:27017/?directConnection=true

# Optional override used only by the test suite. Defaults to the
# localhost URI above if unset.
# MONGODB_TEST_URI=mongodb://localhost:27017/?directConnection=true

# ---------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# There is deliberately no default value in code: the app refuses to
# start without this set.
JWT_SECRET_KEY=replace-me-with-a-generated-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------
# Password hashing
# ---------------------------------------------------------------------
# bcrypt cost factor. Leave at 12 for anything real. The test suite
# overrides this to 4 so that fixtures creating many users stay fast.
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Currencies accounts may be opened in. Each one gets its own SYSTEM
# boundary account, provisioned automatically at startup.
SUPPORTED_CURRENCIES=USD,EUR,GBP,INR

# ---------------------------------------------------------------------
# Rate limiting (in-process; see MEMORY.md known limitations)
# ---------------------------------------------------------------------
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_TRANSACTIONS=100/minute
RATE_LIMIT_DEFAULT=200/minute
